// The bare-wire demo: the same widget tree, but every frame leaves as whole
// rows of text — no cursor addressing, no styles, only the characters and
// newlines a plain serial line can carry. Run it with
// `moon run --target native examples/uart`.
import {
  "moonbitstack/moonetui/app",
  "moonbitstack/moonetui/driver",
  "moonbitstack/moonetui/geom",
  "moonbitstack/moonetui/layout",
  "moonbitstack/moonetui/widget",
}

supported_targets = "native"

pkgtype(kind: "executable")
