name = "moonbitstack/moonetui"

version = "0.1.1"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonetui"

license = "Apache-2.0"

keywords = [ "tui", "terminal", "textual", "widget", "ansi" ]

description = "moonetui — a terminal UI toolkit for MoonBit (after Textual): cell buffer, differential ANSI renderer, incremental key parser, layout, widgets, and pluggable terminal drivers."

preferred_target = "wasm-gc"
