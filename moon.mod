name = "moonbitstack/moonetui"

version = "0.3.3"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonetui"

license = "Apache-2.0"

keywords = [
  "tui",
  "terminal",
  "terminal-ui",
  "cli",
  "console",
  "widget",
  "widgets",
  "ansi",
  "escape-sequences",
  "layout",
  "css",
  "design-system",
  "node",
  "browser",
  "serial",
  "moonbit",
]

description = "A terminal UI toolkit for MoonBit: cell buffer, differential ANSI renderer, incremental key parser, layout, a CSS-like design system, fifty widgets, and drivers for terminals, Node, browsers and serial lines."

source = "src"

import {
  "moonbitstack/moonucd@0.1.3",
  "moonbitstack/moonrgba@0.1.2",
}
