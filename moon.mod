name = "moonbitstack/moonetui"

version = "0.3.4"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonetui"

license = "Apache-2.0"

keywords = [
  "tui",
  "terminal",
  "terminal-ui",
  "tui-framework",
  "cli",
  "console",
  "widget",
  "widgets",
  "dashboard",
  "form",
  "table",
  "tree",
  "chart",
  "slider",
  "calendar",
  "pagination",
  "command-palette",
  "diff",
  "hex-dump",
  "ansi",
  "truecolor",
  "escape-sequences",
  "unicode",
  "layout",
  "css",
  "design-system",
  "node",
  "browser",
  "wasm",
  "serial",
  "moonbit",
]

description = "A terminal UI toolkit for MoonBit: cell buffer, differential ANSI renderer, incremental key parser, layout, a CSS-like design system, fifty-four widgets, and drivers for terminals, Node, browsers and serial lines."

source = "src"

import {
  "moonbitstack/moondate@0.1.5",
  "moonbitstack/moonucd@0.1.3",
  "moonbitstack/moonrgba@0.1.2",
}
