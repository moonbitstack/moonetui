// A real terminal through the C library; Windows runs in virtual terminal mode
// so one parser and one renderer serve both.
import {
  "moonbitlang/core/encoding/utf8",
  "moonbitstack/moonetui/driver",
  "moonbitstack/moonetui/geom",
}

supported_targets = "native"

options(
  "native-stub": [ "tty.c" ],
)
