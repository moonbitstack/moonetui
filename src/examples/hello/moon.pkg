// A header, a list, a field and a footer under Node:
// `moon run --target js src/examples/hello`.
import {
  "moonbitstack/moonetui/app",
  "moonbitstack/moonetui/driver/node",
  "moonbitstack/moonetui/layout",
  "moonbitstack/moonetui/style",
  "moonbitstack/moonetui/widget",
}

supported_targets = "js"

pkgtype(kind: "executable")
