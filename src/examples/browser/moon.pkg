// The gallery and every demo, drawn on canvases in a page. The documentation
// site loads this module; `index.html` beside it is the gallery on its own.
import {
  "moonbitlang/core/debug",
  "moonbitstack/moonetui/app",
  "moonbitstack/moonetui/driver/web",
  "moonbitstack/moonetui/examples/showcase",
  "moonbitstack/moonetui/widget",
}

supported_targets = "js"

options(
  link: { "js": { "exports": [ "start", "mount" ], "format": "esm" } },
)
