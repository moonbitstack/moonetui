// A log tail: the last lines of a file, a column of line numbers, a bar of
// filters that can be typed into, and a map down the right edge that shows
// where the errors are in the whole file. The file is a fixture of two hundred
// lines, generated by rule so the same tail is the same tail.

///|
#derive(Eq)
pub(all) enum Level {
  Info
  Warn
  Error
}

///|
pub extend Level with Eq::{not_equal, equal}

///|
pub struct Line {
  number : Int32
  at : String
  level : Level
  text : String
}

///|
pub struct Tail {
  lines : Array[Line]
  levels : Array[Bool]
  mut cursor : Int32
  mut follow : Bool
  mut typing : Bool
  mut query : String
  mut note : String
}

///|
/// Ten things a service says, in the order it says them.
let sayings : Array[(String, Level)] = [
  ("GET /v1/orders 200 12ms", Info),
  ("POST /v1/checkout 201 84ms", Info),
  ("job 8412 sent in 240ms", Info),
  ("retry stripe (1/3) 502", Warn),
  ("checkpoint starting: time", Info),
  ("job 8414 failed: timeout", Error),
  ("backing off 4s", Warn),
  ("queue orders, concurrency 8", Info),
  ("upstream gave 503 for 3s", Error),
  ("cache warm, 4121 keys", Info),
]

///|
fn two(value : Int32) -> String {
  if value < 10 {
    "0" + value.to_string()
  } else {
    value.to_string()
  }
}

///|
fn clock(at : Int32) -> String {
  two(18 + at / 3600 % 2) + ":" + two(at / 60 % 60) + ":" + two(at % 60)
}

///|
pub fn Tail::new() -> Tail {
  let lines : Array[Line] = []
  for i in 0..<200 {
    let (text, level) = sayings[(i * 7 + i / 5) % 10]
    // Errors come in bursts, the way they do: a run of five at line 122, and a
    // single one every forty-first line. The map down the edge shows them, so
    // they are rare enough to be worth a column of their own.
    let base = if level == Error { Warn } else { level }
    let level = if (i >= 121 && i <= 125) || i % 41 == 7 {
      Error
    } else if i % 11 == 3 {
      Warn
    } else {
      base
    }
    lines.push({ number: 1 + i, at: clock(18 * 3600 + i * 2), level, text, })
  }
  {
    lines,
    levels: [true, true, true],
    cursor: 199,
    follow: true,
    typing: false,
    query: "",
    note: "space holds the tail · / filters",
  }
}

///|
pub fn Tail::count(self : Tail, level : Level) -> Int32 {
  let mut n = 0
  for line in self.lines {
    if line.level == level {
      n = n + 1
    }
  }
  n
}

///|
fn Tail::level_on(self : Tail, level : Level) -> Bool {
  match level {
    Info => self.levels[0]
    Warn => self.levels[1]
    Error => self.levels[2]
  }
}

///|
/// A line is shown when its level is on and its text holds the query.
fn Tail::shown(self : Tail, line : Line) -> Bool {
  if !self.level_on(line.level) {
    return false
  }
  if self.query.length() == 0 {
    return true
  }
  holds(line.text, self.query)
}

///|
fn holds(text : String, part : String) -> Bool {
  if part.length() == 0 || part.length() > text.length() {
    return part.length() == 0
  }
  let mut i = 0
  while i + part.length() <= text.length() {
    if text[i:i + part.length()].to_owned() == part {
      return true
    }
    i = i + 1
  }
  false
}

///|
/// The lines that pass the filters, by their place in the file.
pub fn Tail::visible(self : Tail) -> Array[Int32] {
  let out : Array[Int32] = []
  for i in 0..<self.lines.length() {
    if self.shown(self.lines[i]) {
      out.push(i)
    }
  }
  out
}

///|
pub fn Tail::toggle(self : Tail, slot : Int32) -> Unit {
  if slot >= 0 && slot < 3 {
    self.levels[slot] = !self.levels[slot]
    self.clamp()
    self.note = if self.levels[slot] { "level on" } else { "level off" }
    self.follow = true
  }
}

///|
pub fn Tail::hold(self : Tail) -> Unit {
  self.follow = !self.follow
  self.note = if self.follow { "tailing" } else { "held" }
}

///|
/// The arrows walk the visible lines, and stop at either end.
pub fn Tail::walk(self : Tail, delta : Int32) -> Unit {
  let rows = self.visible()
  if rows.length() == 0 {
    return
  }
  let next = self.cursor + delta
  if next < 0 {
    self.cursor = 0
  } else if next > rows.length() - 1 {
    self.cursor = rows.length() - 1
  } else {
    self.cursor = next
  }
  self.follow = false
}

///|
/// The next error after the cursor, and the first one again when the file ends.
pub fn Tail::next_error(self : Tail) -> Unit {
  let rows = self.visible()
  if rows.length() == 0 {
    return
  }
  let mut step = 1
  while step <= rows.length() {
    let at = (self.cursor + step) % rows.length()
    if self.lines[rows[at]].level == Error {
      self.cursor = at
      self.follow = false
      self.note = "error at line " + self.lines[rows[at]].number.to_string()
      return
    }
    step = step + 1
  }
  self.note = "no errors in the file"
}

///|
/// Keep the cursor inside the lines the filters left.
fn Tail::clamp(self : Tail) -> Unit {
  let shown = self.visible().length()
  if shown == 0 {
    self.cursor = 0
  } else if self.cursor > shown - 1 {
    self.cursor = shown - 1
  }
  if self.cursor < 0 {
    self.cursor = 0
  }
}

///|
pub fn Tail::begin(self : Tail) -> Unit {
  self.typing = true
  self.query = ""
  self.note = "type to filter · enter keeps it"
}

///|
pub fn Tail::letter(self : Tail, ch : Int32) -> Unit {
  let out = StringBuilder()
  out.write_string(self.query)
  out.write_char(ch.unsafe_to_char())
  self.query = out.to_string()
  self.follow = false
}

///|
pub fn Tail::rub(self : Tail) -> Unit {
  if self.query.length() > 0 {
    self.query = self.query[0:self.query.length() - 1].to_owned()
  }
}

///|
pub fn Tail::settle(self : Tail) -> Unit {
  self.clamp()
  self.typing = false
  self.note = if self.query.length() == 0 {
    "no filter"
  } else {
    "filter: " + self.query
  }
}

///|
pub fn Tail::clear(self : Tail) -> Unit {
  self.clamp()
  self.typing = false
  self.query = ""
  self.note = "filter cleared"
}

///|
/// The value of the map column for screen row `row`: the whole file is folded
/// into the column, so an error is a block, a warning a half block, and a
/// stretch of quiet lines a dot.
pub fn Tail::map_at(self : Tail, row : Int32, rows : Int32) -> Level? {
  let span = self.lines.length()
  if span == 0 || rows <= 0 {
    return None
  }
  let from = row * span / rows
  let to = (row + 1) * span / rows
  let mut level = -1
  let mut i = from
  while i < to && i < span {
    let line = self.lines[i]
    let rank = match line.level {
      Info => 0
      Warn => 1
      Error => 2
    }
    if rank > level {
      level = rank
    }
    i = i + 1
  }
  match level {
    2 => Some(Error)
    1 => Some(Warn)
    0 => Some(Info)
    _ => None
  }
}
