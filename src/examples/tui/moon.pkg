// The demo the `tui` example runs, in a package of its own: a main package
// cannot carry tests the checker accepts, and the frame tests are what hold
// the demo's keys to their frames.
import {
  "moonbitstack/moonetui/app",
  "moonbitstack/moonetui/design",
  "moonbitstack/moonetui/layout",
  "moonbitstack/moonetui/examples/theme",
  "moonbitstack/moonetui/widget",
}

// The tests drive the demo through a scripted driver and read the frames back.
import {
  "moonbitstack/moonetui/driver",
  "moonbitstack/moonetui/geom",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/env",
} for "test"
