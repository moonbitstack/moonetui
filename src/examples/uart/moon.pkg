// Whole rows of plain text, as a bare serial line takes them:
// `moon run --target native src/examples/uart`.
import {
  "moonbitstack/moonetui/app",
  "moonbitstack/moonetui/driver",
  "moonbitstack/moonetui/geom",
  "moonbitstack/moonetui/layout",
  "moonbitstack/moonetui/widget",
}

supported_targets = "native"

pkgtype(kind: "executable")
