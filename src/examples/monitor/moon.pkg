// A service monitor with tabs, timers and a command line:
// `moon run --target native src/examples/monitor`.
import {
  "moonbitstack/moonetui/app",
  "moonbitstack/moonetui/design",
  "moonbitstack/moonetui/driver/native",
  "moonbitstack/moonetui/geom",
  "moonbitstack/moonetui/layout",
  "moonbitstack/moonetui/style",
  "moonbitstack/moonetui/widget",
}

supported_targets = "native"

pkgtype(kind: "executable")
