// A virtual terminal: the screen that the escape stream moonetui writes would
// draw on a real one.
//
// The browser driver paints it, and a test or a screenshot reads it, so what an
// application looks like can be checked without a terminal on any target.
import {
  "moonbitlang/core/cmp",
  "moonbitstack/moonetui/strip",
  "moonbitstack/moonetui/style",
}
