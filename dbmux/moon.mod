name = "moonbitstack/dbmux"

version = "0.1.0"

readme = "README.md"

license = "Apache-2.0"

description = "A terminal database client built on moonetui: five engines in one tree, editable tables, a SQL editor, and a command palette."

source = "src"

import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/x@0.5.7",
  "moonbitstack/moondb@0.3.0",
  "moonbitstack/moonjson@0.5.0",
  "moonbitstack/moonmysql@0.8.0",
  "moonbitstack/moonpostgres@0.7.0",
  "moonbitstack/moonetui@0.4.0",
  "moonbitstack/moonredis@0.2.0",
  "moonbitstack/moonsqlite@0.4.0",
  "moonbitstack/moonsqls@0.1.0",
  "moonbitstack/moontoml@0.2.0",
}
